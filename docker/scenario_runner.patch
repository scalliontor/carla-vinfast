@@ -0,0 +1,164 @@
+#!/usr/bin/env python
+
+"""
+Metric tự viết — VinfastCutInMetric
+====================================
+
+MỤC ĐÍCH
+    Vẽ lại diễn biến của kịch bản cắt đầu bằng SỐ LIỆU, thay vì chỉ nhìn bằng mắt:
+        - khoảng cách giữa xe ego và xe NPC theo thời gian
+        - tốc độ của từng xe theo thời gian
+    Nhìn đồ thị là thấy rõ ba pha: NPC lao tới → cắt đầu → giảm tốc đột ngột.
+
+CƠ CHẾ QUAN TRỌNG NHẤT CỦA METRICS MODULE
+    Metric KHÔNG chạy lại mô phỏng. Nó đọc file ghi (.log) mà CARLA recorder đã
+    lưu lúc kịch bản chạy. Nhờ vậy muốn tính lại, đổi công thức, vẽ kiểu khác
+    bao nhiêu lần cũng được mà không phải diễn lại cảnh — vốn rất tốn thời gian.
+
+    Đổi lại: chỉ lấy được những gì recorder đã ghi (vị trí, vận tốc, gia tốc,
+    điều khiển, đèn...). Muốn có dữ liệu cảm biến thì phải thu lúc chạy, không
+    lấy ngược lại được từ file ghi.
+
+CÁCH CHẠY
+    Bước 1 — ghi lại kịch bản (sinh ra .log + .json):
+        python scenario_runner.py --scenario VinfastCutIn_1 --record recordings ...
+
+    Bước 2 — chạy metric (CARLA server phải đang bật):
+        python metrics_manager.py ^
+            --metrics srunner/metrics/examples/vinfast_cutin_metric.py ^
+            --log recordings/VinfastCutIn_1.log ^
+            --criteria recordings/VinfastCutIn_1.json
+"""
+
+import math
+import os
+
+import matplotlib
+# Chọn backend "Agg" khi không có màn hình để savefig vẫn chạy được.
+# Phải gọi TRƯỚC khi import pyplot, nếu không matplotlib đã chốt backend rồi.
+if not os.environ.get("DISPLAY") and os.name != "nt":
+    matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+
+from srunner.metrics.examples.basic_metric import BasicMetric
+
+
+# Nơi lưu đồ thị làm bằng chứng nộp mentor.
+OUT_DIR = r"D:\Hunganh\carla-scenario\evidence\task1"
+OUT_FILE = "task1_06_metric_khoang_cach_toc_do.png"
+
+
+class VinfastCutInMetric(BasicMetric):
+    """
+    Mọi metric đều kế thừa BasicMetric và chỉ cần điền đúng một hàm:
+    _create_metric(). Lớp cha tự gọi nó trong __init__.
+    """
+
+    def _create_metric(self, town_map, log, criteria):
+        """
+        Args:
+            town_map (carla.Map)  — bản đồ, dùng khi cần Waypoint API
+            log (MetricsLog)      — cửa ngõ tra cứu file ghi
+            criteria (dict)       — tiêu chí đã chấm, đọc từ file .json
+        """
+
+        # --- 1. Tìm ID hai xe -------------------------------------------------
+        # Lưu ý tên vai khác nhau giữa hai chế độ:
+        #   --scenario       -> ego mang role_name 'hero',  NPC mang 'scenario'
+        #   --openscenario2  -> ego mang role_name 'ego_vehicle'
+        ego_id = log.get_ego_vehicle_id()
+        npc_ids = log.get_actor_ids_with_role_name("scenario")
+        if not npc_ids:
+            print("[metric] Khong tim thay xe nao co role_name='scenario'")
+            return
+        npc_id = npc_ids[0]
+
+        # --- 2. Khoảng thời gian cả hai xe cùng tồn tại ------------------------
+        # Hai xe không spawn cùng lúc và không bị huỷ cùng lúc, nên phải lấy
+        # phần giao nhau, nếu không sẽ tra vào frame mà một trong hai chưa/hết tồn tại.
+        start_ego, end_ego = log.get_actor_alive_frames(ego_id)
+        start_npc, end_npc = log.get_actor_alive_frames(npc_id)
+        start = max(start_ego, start_npc)
+        end = min(end_ego, end_npc)
+
+        times, distances, speed_ego, speed_npc = [], [], [], []
+
+        for frame in range(start, end):
+            ego_tf = log.get_actor_transform(ego_id, frame)
+            npc_tf = log.get_actor_transform(npc_id, frame)
+            if ego_tf is None or npc_tf is None:
+                continue
+
+            # BỎ QUA giai đoạn NPC còn nằm dưới mặt đất.
+            # Kịch bản spawn NPC ở z = -100 rồi mới nhấc lên (xem vinfast_cutin_slow.py).
+            # Không lọc thì đồ thị có một đoạn khoảng cách ~100 m vô nghĩa ở đầu.
+            if npc_tf.location.z < -10:
+                continue
+
+            d = ego_tf.location - npc_tf.location
+            distances.append(math.sqrt(d.x * d.x + d.y * d.y + d.z * d.z))
+
+            # get_elapsed_time trả về giây mô phỏng — dễ đọc hơn số thứ tự frame.
+            times.append(log.get_elapsed_time(frame))
+
+            # Vận tốc là vector 3 chiều, đổi sang km/h cho dễ đối chiếu với HUD.
+            v_ego = log.get_actor_velocity(ego_id, frame)
+            v_npc = log.get_actor_velocity(npc_id, frame)
+            speed_ego.append(3.6 * math.sqrt(v_ego.x ** 2 + v_ego.y ** 2 + v_ego.z ** 2))
+            speed_npc.append(3.6 * math.sqrt(v_npc.x ** 2 + v_npc.y ** 2 + v_npc.z ** 2))
+
+        if not times:
+            print("[metric] Khong co frame nao dung dieu kien")
+            return
+
+        # --- 3. Đối chiếu với tiêu chí đã chấm --------------------------------
+        # criteria đọc từ file .json mà scenario_runner ghi ra. Nhờ vậy đồ thị và
+        # bảng kết quả nói cùng một câu chuyện.
+        n_collisions = None
+        if criteria and "CollisionTest" in criteria:
+            n_collisions = criteria["CollisionTest"].get("actual_value")
+
+        min_dist = min(distances)
+        print("\n================ KET QUA METRIC ================")
+        print(" So frame phan tich     : %d" % len(times))
+        print(" Thoi gian mo phong     : %.1f s" % (times[-1] - times[0]))
+        print(" Khoang cach GAN NHAT   : %.2f m  (giay thu %.1f)"
+              % (min_dist, times[distances.index(min_dist)]))
+        print(" Toc do ego  min/max    : %.1f / %.1f km/h" % (min(speed_ego), max(speed_ego)))
+        print(" Toc do NPC  min/max    : %.1f / %.1f km/h" % (min(speed_npc), max(speed_npc)))
+        if n_collisions is not None:
+            print(" CollisionTest ghi nhan : %s va cham" % n_collisions)
+        print("================================================\n")
+
+        # --- 4. Vẽ đồ thị hai tầng dùng CHUNG trục thời gian -------------------
+        # Dùng chung trục x (sharex) để đọc theo cột: nhìn thẳng từ đáy khoảng cách
+        # lên là thấy ngay lúc đó tốc độ hai xe bao nhiêu.
+        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
+
+        ax1.plot(times, distances, linewidth=2, color="#2a78d6")
+        ax1.axhline(y=min_dist, linestyle="--", linewidth=1, color="#d03b3b")
+        ax1.annotate("gan nhat %.1f m" % min_dist,
+                     xy=(times[distances.index(min_dist)], min_dist),
+                     xytext=(8, 10), textcoords="offset points", color="#d03b3b")
+        ax1.set_ylabel("Khoang cach [m]")
+        ax1.set_title("Kich ban VinfastCutIn — khoang cach va toc do theo thoi gian")
+        ax1.grid(alpha=.3)
+
+        ax2.plot(times, speed_ego, linewidth=2, label="ego (Lincoln Mkz)", color="#2a78d6")
+        ax2.plot(times, speed_npc, linewidth=2, label="NPC (Tesla Model 3)", color="#eb6834")
+        ax2.set_ylabel("Toc do [km/h]")
+        ax2.set_xlabel("Thoi gian mo phong [s]")
+        ax2.legend()
+        ax2.grid(alpha=.3)
+
+        fig.tight_layout()
+
+        os.makedirs(OUT_DIR, exist_ok=True)
+        out_path = os.path.join(OUT_DIR, OUT_FILE)
+        fig.savefig(out_path, dpi=130)
+        print("[metric] Da luu do thi: %s" % out_path)
+
+        try:
+            plt.show()
+        except Exception:      # không có màn hình thì thôi, ảnh đã lưu rồi
+            pass
