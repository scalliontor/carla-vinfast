@@ -0,0 +1,221 @@
+#!/usr/bin/env python
+
+"""
+Kịch bản tự viết — VinfastCutInAndSlow
+=======================================
+
+MỤC ĐÍCH
+    Tái hiện bằng Python đúng tình huống mà file OSC2 `cut_in_and_slow_range.osc` mô tả:
+    xe NPC bám theo, vượt lên, CẮT ĐẦU xe ego, RỒI GIẢM TỐC ĐỘT NGỘT.
+
+VÌ SAO VIẾT LẠI THAY VÌ DÙNG `cut_in.py` CÓ SẴN
+    `cut_in.py` gốc dừng ở bước cắt đầu rồi chạy tiếp 200 m — KHÔNG có pha giảm tốc.
+    Mà chính pha giảm tốc mới là thứ tạo ra nguy hiểm: chênh lệch tốc độ tiếp cận.
+    Thêm pha đó vào giúp so sánh sòng phẳng hai cách mô tả cùng một kịch bản:
+
+        OSC2  : khai báo ý định, bộ giải tự lo    -> ego bị kịch bản lái, luôn đâm
+        Python: dựng tay từng nút của cây hành vi -> ego do người/autopilot lái
+
+CÁCH SCENARIO RUNNER TÌM THẤY FILE NÀY
+    Không cần đăng ký ở đâu cả. `scenario_runner.py:167` quét toàn bộ
+    `srunner/scenarios/*.py`, import từng module rồi tìm class có tên TRÙNG với
+    thuộc tính `type=` trong file XML cấu hình.
+    -> Chỉ cần thả file vào đây + đặt type="VinfastCutInAndSlow" trong XML.
+
+CHẠY
+    python scenario_runner.py --scenario VinfastCutIn_1 --reloadWorld --timeout 600 --output
+    python manual_control.py -a --rolename hero        (cửa sổ thứ hai, autopilot lái ego)
+"""
+
+import py_trees
+import carla
+
+from srunner.scenariomanager.carla_data_provider import CarlaDataProvider
+from srunner.scenariomanager.scenarioatomics.atomic_behaviors import (
+    ActorTransformSetter,
+    AccelerateToCatchUp,
+    LaneChange,
+    WaypointFollower,
+)
+from srunner.scenariomanager.scenarioatomics.atomic_criteria import (
+    CollisionTest,
+    DrivenDistanceTest,
+)
+from srunner.scenariomanager.scenarioatomics.atomic_trigger_conditions import (
+    DriveDistance,
+    InTriggerDistanceToVehicle,
+)
+from srunner.scenarios.basic_scenario import BasicScenario
+
+
+class VinfastCutInAndSlow(BasicScenario):
+    """
+    NPC cắt đầu xe ego rồi giảm tốc đột ngột.
+
+    Mọi kịch bản đều kế thừa BasicScenario và điền hai phương thức:
+        _create_behavior()      -> cây hành vi (NPC làm gì)
+        _create_test_criteria() -> tiêu chí chấm điểm (thế nào là đạt)
+    """
+
+    timeout = 600
+
+    # --- Tham số của kịch bản, gom lên đầu để dễ chỉnh khi thí nghiệm ----------
+    _npc_cruise_speed = 40      # km/h, tốc độ NPC lúc bám theo ego
+    _npc_slow_speed = 10        # km/h, tốc độ NPC SAU khi cắt đầu  <- nguồn nguy hiểm
+    _trigger_distance = 30      # m, NPC tới gần ego bằng này thì bắt đầu tăng tốc vượt
+    _slow_distance = 60         # m, quãng đường NPC bò chậm trước khi kịch bản kết thúc
+    _end_distance = 150         # m, ego đi được bằng này thì kết thúc kịch bản
+
+    def __init__(self, world, ego_vehicles, config, randomize=False,
+                 debug_mode=False, criteria_enable=True, timeout=600):
+        self.timeout = timeout
+        self._map = CarlaDataProvider.get_map()
+
+        # trigger_points[0] là điểm spawn của xe ego, lấy từ file XML.
+        # Dùng waypoint ở đây để biết kịch bản diễn ra trên đoạn đường nào.
+        self._reference_waypoint = self._map.get_waypoint(config.trigger_points[0].location)
+
+        self._transform_visible = None
+
+        # Gọi hàm khởi tạo của lớp cha. Chính nó sẽ gọi _initialize_actors(),
+        # _create_behavior() và _create_test_criteria() theo đúng thứ tự.
+        super(VinfastCutInAndSlow, self).__init__(
+            "VinfastCutInAndSlow",
+            ego_vehicles,
+            config,
+            world,
+            debug_mode,
+            criteria_enable=criteria_enable,
+        )
+
+    # ------------------------------------------------------------------------
+    def _initialize_actors(self, config):
+        """
+        Spawn các diễn viên không phải ego, đọc từ thẻ <other_actor> trong XML.
+
+        MẸO QUAN TRỌNG — vì sao XML để z = -100:
+            Nếu spawn NPC ngay trên đường, người lái ego sẽ nhìn thấy nó đứng chờ
+            từ đầu, mất tính bất ngờ. Nên XML đặt NPC nằm SÂU DƯỚI MẶT ĐẤT (z=-100),
+            tắt vật lý, rồi tới đúng lúc mới nhấc lên bằng ActorTransformSetter.
+            Cộng 105 m là để bù lại -100 và nhô lên trên mặt đường một chút.
+        """
+        for actor in config.other_actors:
+            vehicle = CarlaDataProvider.request_new_actor(actor.model, actor.transform)
+            self.other_actors.append(vehicle)
+            # Tắt vật lý trong lúc còn nằm dưới đất, tránh rơi tự do vô nghĩa.
+            vehicle.set_simulate_physics(enabled=False)
+
+        npc_transform = self.other_actors[0].get_transform()
+        self._transform_visible = carla.Transform(
+            carla.Location(npc_transform.location.x,
+                           npc_transform.location.y,
+                           npc_transform.location.z + 105),
+            npc_transform.rotation,
+        )
+
+    # ------------------------------------------------------------------------
+    def _create_behavior(self):
+        """
+        Cây hành vi py_trees. Đọc từ trên xuống chính là kịch bản diễn ra theo thứ tự.
+
+        NHẮC LẠI HAI LOẠI NÚT GHÉP:
+            Sequence  — chạy con thứ nhất xong mới tới con thứ hai
+            Parallel  — chạy đồng thời; ở đây dùng SUCCESS_ON_ONE nghĩa là
+                        CHỈ CẦN MỘT con báo SUCCESS là cả nhánh kết thúc.
+
+        Vì sao cần SUCCESS_ON_ONE: WaypointFollower chạy MÃI MÃI, không bao giờ tự
+        kết thúc. Muốn nó dừng thì phải ghép song song với một điều kiện dừng
+        (khoảng cách, quãng đường...). Đây là khuôn mẫu lặp đi lặp lại trong mọi
+        kịch bản của Scenario Runner.
+        """
+        root = py_trees.composites.Sequence("VinfastCutInAndSlow")
+
+        # --- Pha 0: nhấc NPC từ dưới đất lên đường, bật lại vật lý --------------
+        root.add_child(
+            ActorTransformSetter(self.other_actors[0], self._transform_visible)
+        )
+
+        # --- Pha 1: NPC chạy ở làn bên cho tới khi tới gần ego ------------------
+        approach = py_trees.composites.Parallel(
+            "NPC bam theo ego",
+            policy=py_trees.common.ParallelPolicy.SUCCESS_ON_ONE,
+        )
+        approach.add_child(WaypointFollower(self.other_actors[0], self._npc_cruise_speed))
+        approach.add_child(
+            InTriggerDistanceToVehicle(
+                self.other_actors[0], self.ego_vehicles[0], self._trigger_distance
+            )
+        )
+        root.add_child(approach)
+
+        # --- Pha 2: tăng tốc vượt lên ngang ego --------------------------------
+        root.add_child(
+            AccelerateToCatchUp(
+                self.other_actors[0],
+                self.ego_vehicles[0],
+                throttle_value=1,
+                delta_velocity=10,
+                trigger_distance=5,
+                max_distance=500,
+            )
+        )
+
+        # --- Pha 3: cắt đầu, chuyển sang làn của ego ---------------------------
+        # XML đặt NPC ở làn BÊN TRÁI nên cắt sang phải mới vào làn ego.
+        root.add_child(
+            LaneChange(
+                self.other_actors[0],
+                speed=None,              # None = giữ nguyên tốc độ đang có
+                direction='right',
+                distance_same_lane=5,
+                distance_other_lane=100,
+            )
+        )
+
+        # --- Pha 4: GIẢM TỐC ĐỘT NGỘT  <- đây là phần cut_in.py gốc KHÔNG có ----
+        # Đúng pha `slow` của bản OSC2. Chênh lệch tốc độ tiếp cận sinh ra ở đây.
+        brake_check = py_trees.composites.Parallel(
+            "NPC giam toc dot ngot",
+            policy=py_trees.common.ParallelPolicy.SUCCESS_ON_ONE,
+        )
+        brake_check.add_child(WaypointFollower(self.other_actors[0], self._npc_slow_speed))
+        brake_check.add_child(DriveDistance(self.other_actors[0], self._slow_distance))
+        root.add_child(brake_check)
+
+        # --- Pha 5: điều kiện kết thúc -----------------------------------------
+        # Không có nút này thì kịch bản chạy tới khi hết timeout.
+        root.add_child(DriveDistance(self.ego_vehicles[0], self._end_distance))
+
+        return root
+
+    # ------------------------------------------------------------------------
+    def _create_test_criteria(self):
+        """
+        Danh sách tiêu chí chấm điểm. Scenario Runner tự ghép chúng thành một
+        nhánh py_trees song song chạy nền suốt kịch bản.
+
+        optional=False -> trượt tiêu chí này là cả kịch bản FAILURE
+        optional=True  -> chỉ ghi nhận số liệu, không làm hỏng kết quả chung
+        """
+        criteria = []
+
+        # Tiêu chí chính: ego có đâm vào gì không. Đây là thứ phân định đạt/không đạt.
+        criteria.append(CollisionTest(self.ego_vehicles[0]))
+
+        # Tiêu chí phụ: ego có thực sự chạy được quãng đường mong đợi không.
+        # Để optional=True vì nếu ego phanh gấp để tránh đâm thì nó đi ngắn hơn —
+        # đó là hành vi ĐÚNG, không nên bị tính là trượt.
+        criteria.append(
+            DrivenDistanceTest(
+                self.ego_vehicles[0],
+                distance=self._end_distance,
+                optional=True,
+            )
+        )
+
+        return criteria
+
+    # ------------------------------------------------------------------------
+    def __del__(self):
+        """Dọn dẹp sau khi kịch bản kết thúc."""
+        self.remove_all_actors()
