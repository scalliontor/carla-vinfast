# Chep thanh .env roi sua. Moi nguoi tren may dung chung mot bo rieng.
COMPOSE_PROJECT_NAME=carla-vinfast

# Dai 3 cong RPC/streaming/secondary phia HOST (trong container van la 2000-2002)
CARLA_HOST_PORT=2000
CARLA_HOST_PORT_END=2002

# GPU cap cho server: all, hoac chi so GPU vd "1"
NVIDIA_VISIBLE_DEVICES=all

# Low | Epic
CARLA_QUALITY=Low

# UID/GID cua user trong image client - CHI co tac dung khi build lai image
# (docker-compose.build.yml). May dich chi load image thi bo qua.
HOST_UID=1000
HOST_GID=1000
